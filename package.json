{
  "name": "emissor-nfse-lote",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node --experimental-strip-types scripts/prepare-danfse-fonts.ts && node --experimental-strip-types scripts/check-stripe-config.ts && npm run prepare:panel-preview && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:db": "python3 tests/database/run-tenancy.py",
    "prepare:panel-preview": "node --experimental-strip-types scripts/generate-panel-preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@next/env": "16.4.6",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@xmldom/xmldom": "0.9.12",
    "csv-parse": "7.0.3",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "node-forge": "1.4.3",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "xml-crypto": "6.4.0",
    "xmllint-wasm": "5.3.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "158.0.0",
    "@types/node": "24.19.2",
    "@types/node-forge": "1.3.14",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsqr": "1.4.0",
    "playwright-core": "1.61.1",
    "pngjs": "5.0.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  },
  "type": "module"
}
