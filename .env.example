STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_ENABLED=false

# Entrega de XML autorizado: nunca usar NEXT_PUBLIC. Configure migração 17 e domínio verificado antes de ativar.
