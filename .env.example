# Valores públicos disponíveis em Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://lcueompcxefjszkrtyyp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origem exata desta aplicação, sem barra final. Na Vercel, use seu domínio HTTPS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Somente servidor. Valores sensíveis nunca devem usar NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Manter false até testar A1, contrato oficial e transmissão em homologação. Nunca libera produção.
NFSE_HOMOLOGATION_ENABLED=false
# Somente servidor. Produção por relatório MEI exige migração 21, contratos/acesso próprios
# e confirmação explícita de emissão real e entrega no resumo do lote.
NFSE_PRODUCTION_ENABLED=false

# Pagamentos: começar com chaves TEST da Stripe. Nunca usar NEXT_PUBLIC.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_ENABLED=false

# Entrega de XML + DANFS-e oficial autorizados: nunca usar NEXT_PUBLIC.
# Configure migrações 17/20/21, domínio/remetente e provedores antes de ativar.
NFSE_EMAIL_ENABLED=false
NFSE_EMAIL_FROM=notas@rexnotas.com.br
# Homologação sempre usa SOMENTE este endereço; produção confirmada usa os destinos revisados do CSV.
NFSE_EMAIL_TEST_TO=
EMAIL_WORKER_SECRET=
# Prioridade fixa. Cada provedor é opcional; cadastre/verifique o mesmo remetente em todos os ativados.
BREVO_API_KEY=
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Server/build only. Keep portable until both operator-provided fonts are in PRIVATE storage.
# nt008 uses danfse-fonts/arialbd.ttf and danfse-fonts/micross.ttf, downloaded at build time.
DANFSE_FONT_PROFILE=portable
# Default source for nt008: supabase. Use local only for an offline build with private files present.
DANFSE_FONT_SOURCE=supabase
